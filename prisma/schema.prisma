generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  plan       String   @default("starter")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  users       User[]
  leads       Lead[]
  deals       Deal[]
  pipelines   Pipeline[]
  automations Automation[]
  proposals   Proposal[]
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  password       String
  name           String
  role           String    @default("sales_rep") // owner, admin, sales_rep
  avatar         String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  ownedDeals  Deal[]     @relation("DealOwner")
  activities  Activity[]
}

model Lead {
  id             String   @id @default(cuid())
  name           String
  email          String
  company        String?
  website        String?
  phone          String?
  title          String?
  source         String   @default("manual") // cold, inbound, referral, form, csv, manual
  status         String   @default("new")    // new, contacted, qualified, disqualified
  tags           Json     @default("[]")
  notes          String?
  linkedinUrl    String?
  score          Int      @default(0)        // 0-100 AI-computed lead score
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  deals      Deal[]
  activities Activity[]
}

model Pipeline {
  id             String   @id @default(cuid())
  name           String
  isDefault      Boolean  @default(false)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  stages Stage[]
}

model Stage {
  id         String   @id @default(cuid())
  name       String
  order      Int
  color      String   @default("#6366f1")
  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  deals Deal[]
}

model Deal {
  id                String    @id @default(cuid())
  title             String
  value             Float     @default(0)
  currency          String    @default("USD")
  expectedCloseDate DateTime?
  status            String    @default("open")     // open, won, lost
  priority          String    @default("medium")   // low, medium, high
  probability       Int       @default(20)         // 0-100
  notes             String?
  lostReason        String?
  stageId           String
  stage             Stage     @relation(fields: [stageId], references: [id])
  leadId            String?
  lead              Lead?     @relation(fields: [leadId], references: [id])
  ownerId           String?
  owner             User?     @relation("DealOwner", fields: [ownerId], references: [id])
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  activities      Activity[]
  proposals       Proposal[]
  dealAutomations DealAutomation[]
}

model Activity {
  id          String    @id @default(cuid())
  type        String    // email, call, meeting, note, task, stage_change
  title       String
  description String?
  status      String    @default("pending")    // pending, completed, cancelled
  direction   String?                          // inbound, outbound (for emails/calls)
  dueDate     DateTime?
  completedAt DateTime?
  dealId      String?
  deal        Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  leadId      String?
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Proposal {
  id             String    @id @default(cuid())
  title          String
  content        String
  status         String    @default("draft") // draft, sent, viewed, accepted, rejected
  sentAt         DateTime?
  viewedAt       DateTime?
  respondedAt    DateTime?
  totalValue     Float     @default(0)
  validUntil     DateTime?
  dealId         String
  deal           Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Automation {
  id             String   @id @default(cuid())
  name           String
  description    String?
  trigger        String   // stage_enter, stage_exit, time_delay, no_reply, deal_created, deal_won, deal_lost
  triggerConfig  Json     @default("{}")
  actions        Json     @default("[]")
  isActive       Boolean  @default(true)
  executionCount Int      @default(0)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  dealAutomations DealAutomation[]
}

model DealAutomation {
  id           String     @id @default(cuid())
  dealId       String
  deal         Deal       @relation(fields: [dealId], references: [id], onDelete: Cascade)
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  status       String     @default("pending") // pending, running, completed, failed, cancelled
  scheduledAt  DateTime
  executedAt   DateTime?
  result       String?
  createdAt    DateTime   @default(now())
}
